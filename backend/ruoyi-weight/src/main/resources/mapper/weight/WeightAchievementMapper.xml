<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.weight.mapper.WeightAchievementMapper">
    
    <resultMap type="WeightAchievement" id="WeightAchievementResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="badgeType"    column="badge_type"    />
        <result property="badgeName"    column="badge_name"    />
        <result property="badgeIcon"    column="badge_icon"    />
        <result property="badgeDescription"    column="badge_description"    />
        <result property="unlockedAt"    column="unlocked_at"    />
        <result property="progress"    column="progress"    />
        <result property="isUnlocked"    column="is_unlocked"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWeightAchievementVo">
        select id, user_id, badge_type, badge_name, badge_icon, badge_description, unlocked_at, progress, is_unlocked, create_time, update_time from weight_achievement
    </sql>

    <select id="selectWeightAchievementList" parameterType="WeightAchievement" resultMap="WeightAchievementResult">
        <include refid="selectWeightAchievementVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="badgeType != null  and badgeType != ''"> and badge_type = #{badgeType}</if>
            <if test="badgeName != null  and badgeName != ''"> and badge_name like concat('%', #{badgeName}, '%')</if>
            <if test="badgeIcon != null  and badgeIcon != ''"> and badge_icon = #{badgeIcon}</if>
            <if test="badgeDescription != null  and badgeDescription != ''"> and badge_description = #{badgeDescription}</if>
            <if test="unlockedAt != null "> and unlocked_at = #{unlockedAt}</if>
            <if test="progress != null "> and progress = #{progress}</if>
            <if test="isUnlocked != null "> and is_unlocked = #{isUnlocked}</if>
        </where>
    </select>
    
    <select id="selectWeightAchievementById" parameterType="Long" resultMap="WeightAchievementResult">
        <include refid="selectWeightAchievementVo"/>
        where id = #{id}
    </select>

    <insert id="insertWeightAchievement" parameterType="WeightAchievement" useGeneratedKeys="true" keyProperty="id">
        insert into weight_achievement
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="badgeType != null and badgeType != ''">badge_type,</if>
            <if test="badgeName != null and badgeName != ''">badge_name,</if>
            <if test="badgeIcon != null">badge_icon,</if>
            <if test="badgeDescription != null">badge_description,</if>
            <if test="unlockedAt != null">unlocked_at,</if>
            <if test="progress != null">progress,</if>
            <if test="isUnlocked != null">is_unlocked,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="badgeType != null and badgeType != ''">#{badgeType},</if>
            <if test="badgeName != null and badgeName != ''">#{badgeName},</if>
            <if test="badgeIcon != null">#{badgeIcon},</if>
            <if test="badgeDescription != null">#{badgeDescription},</if>
            <if test="unlockedAt != null">#{unlockedAt},</if>
            <if test="progress != null">#{progress},</if>
            <if test="isUnlocked != null">#{isUnlocked},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateWeightAchievement" parameterType="WeightAchievement">
        update weight_achievement
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="badgeType != null and badgeType != ''">badge_type = #{badgeType},</if>
            <if test="badgeName != null and badgeName != ''">badge_name = #{badgeName},</if>
            <if test="badgeIcon != null">badge_icon = #{badgeIcon},</if>
            <if test="badgeDescription != null">badge_description = #{badgeDescription},</if>
            <if test="unlockedAt != null">unlocked_at = #{unlockedAt},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="isUnlocked != null">is_unlocked = #{isUnlocked},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWeightAchievementById" parameterType="Long">
        delete from weight_achievement where id = #{id}
    </delete>

    <delete id="deleteWeightAchievementByIds" parameterType="String">
        delete from weight_achievement where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>