<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.weight.mapper.WeightCircleDepositMapper">
    
    <resultMap type="WeightCircleDeposit" id="WeightCircleDepositResult">
        <result property="id"    column="id"    />
        <result property="circleId"    column="circle_id"    />
        <result property="userId"    column="user_id"    />
        <result property="amount"    column="amount"    />
        <result property="status"    column="status"    />
        <result property="paidAt"    column="paid_at"    />
        <result property="refundedAt"    column="refunded_at"    />
        <result property="deductReason"    column="deduct_reason"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWeightCircleDepositVo">
        select id, circle_id, user_id, amount, status, paid_at, refunded_at, deduct_reason, create_time, update_time from weight_circle_deposit
    </sql>

    <select id="selectWeightCircleDepositList" parameterType="WeightCircleDeposit" resultMap="WeightCircleDepositResult">
        <include refid="selectWeightCircleDepositVo"/>
        <where>  
            <if test="circleId != null "> and circle_id = #{circleId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="paidAt != null "> and paid_at = #{paidAt}</if>
            <if test="refundedAt != null "> and refunded_at = #{refundedAt}</if>
            <if test="deductReason != null  and deductReason != ''"> and deduct_reason = #{deductReason}</if>
        </where>
    </select>
    
    <select id="selectWeightCircleDepositById" parameterType="Long" resultMap="WeightCircleDepositResult">
        <include refid="selectWeightCircleDepositVo"/>
        where id = #{id}
    </select>

    <insert id="insertWeightCircleDeposit" parameterType="WeightCircleDeposit" useGeneratedKeys="true" keyProperty="id">
        insert into weight_circle_deposit
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="circleId != null">circle_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null">status,</if>
            <if test="paidAt != null">paid_at,</if>
            <if test="refundedAt != null">refunded_at,</if>
            <if test="deductReason != null">deduct_reason,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="circleId != null">#{circleId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null">#{status},</if>
            <if test="paidAt != null">#{paidAt},</if>
            <if test="refundedAt != null">#{refundedAt},</if>
            <if test="deductReason != null">#{deductReason},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateWeightCircleDeposit" parameterType="WeightCircleDeposit">
        update weight_circle_deposit
        <trim prefix="SET" suffixOverrides=",">
            <if test="circleId != null">circle_id = #{circleId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="paidAt != null">paid_at = #{paidAt},</if>
            <if test="refundedAt != null">refunded_at = #{refundedAt},</if>
            <if test="deductReason != null">deduct_reason = #{deductReason},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWeightCircleDepositById" parameterType="Long">
        delete from weight_circle_deposit where id = #{id}
    </delete>

    <delete id="deleteWeightCircleDepositByIds" parameterType="String">
        delete from weight_circle_deposit where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>