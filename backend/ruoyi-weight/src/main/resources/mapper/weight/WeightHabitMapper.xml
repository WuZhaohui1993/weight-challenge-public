<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.weight.mapper.WeightHabitMapper">
    
    <resultMap type="WeightHabit" id="WeightHabitResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="name"    column="name"    />
        <result property="icon"    column="icon"    />
        <result property="period"    column="period"    />
        <result property="frequency"    column="frequency"    />
        <result property="reminderTime"    column="reminder_time"    />
        <result property="isActive"    column="is_active"    />
        <result property="currentStreak"    column="current_streak"    />
        <result property="longestStreak"    column="longest_streak"    />
        <result property="totalCheckins"    column="total_checkins"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWeightHabitVo">
        select id, user_id, name, icon, period, frequency, reminder_time, is_active, current_streak, longest_streak, total_checkins, status, create_by, create_time, update_by, update_time, remark from weight_habit
    </sql>

    <select id="selectWeightHabitList" parameterType="WeightHabit" resultMap="WeightHabitResult">
        <include refid="selectWeightHabitVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="period != null  and period != ''"> and period = #{period}</if>
            <if test="frequency != null  and frequency != ''"> and frequency = #{frequency}</if>
            <if test="reminderTime != null "> and reminder_time = #{reminderTime}</if>
            <if test="isActive != null "> and is_active = #{isActive}</if>
            <if test="currentStreak != null "> and current_streak = #{currentStreak}</if>
            <if test="longestStreak != null "> and longest_streak = #{longestStreak}</if>
            <if test="totalCheckins != null "> and total_checkins = #{totalCheckins}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectWeightHabitById" parameterType="Long" resultMap="WeightHabitResult">
        <include refid="selectWeightHabitVo"/>
        where id = #{id}
    </select>

    <insert id="insertWeightHabit" parameterType="WeightHabit" useGeneratedKeys="true" keyProperty="id">
        insert into weight_habit
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="icon != null">icon,</if>
            <if test="period != null">period,</if>
            <if test="frequency != null">frequency,</if>
            <if test="reminderTime != null">reminder_time,</if>
            <if test="isActive != null">is_active,</if>
            <if test="currentStreak != null">current_streak,</if>
            <if test="longestStreak != null">longest_streak,</if>
            <if test="totalCheckins != null">total_checkins,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="icon != null">#{icon},</if>
            <if test="period != null">#{period},</if>
            <if test="frequency != null">#{frequency},</if>
            <if test="reminderTime != null">#{reminderTime},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="currentStreak != null">#{currentStreak},</if>
            <if test="longestStreak != null">#{longestStreak},</if>
            <if test="totalCheckins != null">#{totalCheckins},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateWeightHabit" parameterType="WeightHabit">
        update weight_habit
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="period != null">period = #{period},</if>
            <if test="frequency != null">frequency = #{frequency},</if>
            <if test="reminderTime != null">reminder_time = #{reminderTime},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="currentStreak != null">current_streak = #{currentStreak},</if>
            <if test="longestStreak != null">longest_streak = #{longestStreak},</if>
            <if test="totalCheckins != null">total_checkins = #{totalCheckins},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWeightHabitById" parameterType="Long">
        delete from weight_habit where id = #{id}
    </delete>

    <delete id="deleteWeightHabitByIds" parameterType="String">
        delete from weight_habit where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>