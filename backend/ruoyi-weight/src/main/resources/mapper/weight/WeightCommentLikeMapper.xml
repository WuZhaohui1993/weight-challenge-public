<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.weight.mapper.WeightCommentLikeMapper">
    
    <resultMap type="WeightCommentLike" id="WeightCommentLikeResult">
        <result property="id"    column="id"    />
        <result property="commentId"    column="comment_id"    />
        <result property="userId"    column="user_id"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectWeightCommentLikeVo">
        select id, comment_id, user_id, create_time from weight_comment_like
    </sql>

    <select id="selectWeightCommentLikeList" parameterType="WeightCommentLike" resultMap="WeightCommentLikeResult">
        <include refid="selectWeightCommentLikeVo"/>
        <where>  
            <if test="commentId != null "> and comment_id = #{commentId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
        </where>
    </select>
    
    <select id="selectWeightCommentLikeById" parameterType="Long" resultMap="WeightCommentLikeResult">
        <include refid="selectWeightCommentLikeVo"/>
        where id = #{id}
    </select>

    <insert id="insertWeightCommentLike" parameterType="WeightCommentLike" useGeneratedKeys="true" keyProperty="id">
        insert into weight_comment_like
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="commentId != null">comment_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="commentId != null">#{commentId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateWeightCommentLike" parameterType="WeightCommentLike">
        update weight_comment_like
        <trim prefix="SET" suffixOverrides=",">
            <if test="commentId != null">comment_id = #{commentId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWeightCommentLikeById" parameterType="Long">
        delete from weight_comment_like where id = #{id}
    </delete>

    <delete id="deleteWeightCommentLikeByIds" parameterType="String">
        delete from weight_comment_like where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>