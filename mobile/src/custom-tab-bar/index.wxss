.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 112rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 14rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 22rpx rgba(39, 92, 72, 0.045);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  border-top: 1px solid rgba(39, 92, 72, 0.08);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9AA79F;
  transition: transform 0.18s ease;
}

.tab-item.active {
  color: #168A62;
}

.tab-item:active {
  transform: scale(0.98);
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 8rpx;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 600;
}

/* 中间突出按钮 */
.tab-center {
  position: relative;
  top: -42rpx;
}

.center-btn {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1FA873, #35C58D);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(47, 179, 123, 0.22);
}

.center-icon {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

/* Action Sheet 弹窗 */
.action-sheet {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 32, 28, 0.42);
  z-index: 1000;
  display: none;
}

.action-sheet.show {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.action-sheet-content {
  background:
    radial-gradient(circle at 16% 0%, rgba(232, 248, 241, 0.82), transparent 32%),
    rgba(255, 255, 255, 0.98);
  border-top-left-radius: 52rpx;
  border-top-right-radius: 52rpx;
  padding: 52rpx 32rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 28rpx rgba(39, 92, 72, 0.08);
}

.action-sheet-header {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #17231F;
}

.action-item {
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(39, 92, 72, 0.055);
  border-radius: 28rpx;
  padding: 26rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.action-item.primary {
  background: linear-gradient(135deg, rgba(232, 248, 241, 0.98), rgba(255, 250, 240, 0.92));
  flex-direction: row;
  justify-content: flex-start;
  gap: 24rpx;
  padding: 32rpx;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: rgba(232, 248, 241, 0.72);
}

.action-info {
  display: flex;
  flex-direction: column;
}

.action-item.primary .action-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #17231F;
}

.action-desc {
  font-size: 22rpx;
  color: #61716A;
  margin-top: 8rpx;
}

.action-sub-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.action-sub-grid .action-item {
  height: 160rpx;
  margin-bottom: 0;
}

.action-sub-grid .action-name {
  font-size: 24rpx;
  margin-top: 16rpx;
  color: #17231F;
}

.action-sheet-close {
  margin-top: 32rpx;
  text-align: center;
  font-size: 44rpx;
  color: #9AA79F;
  padding: 20rpx;
}
