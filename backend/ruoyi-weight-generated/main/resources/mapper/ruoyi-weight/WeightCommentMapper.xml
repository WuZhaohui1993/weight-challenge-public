<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.weight.mapper.WeightCommentMapper">
    
    <resultMap type="WeightComment" id="WeightCommentResult">
        <result property="id"    column="id"    />
        <result property="feedId"    column="feed_id"    />
        <result property="userId"    column="user_id"    />
        <result property="content"    column="content"    />
        <result property="replyToCommentId"    column="reply_to_comment_id"    />
        <result property="replyToUserId"    column="reply_to_user_id"    />
        <result property="likesCount"    column="likes_count"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWeightCommentVo">
        select id, feed_id, user_id, content, reply_to_comment_id, reply_to_user_id, likes_count, status, del_flag, create_by, create_time, update_by, update_time from weight_comment
    </sql>

    <select id="selectWeightCommentList" parameterType="WeightComment" resultMap="WeightCommentResult">
        <include refid="selectWeightCommentVo"/>
        <where>  
            <if test="feedId != null "> and feed_id = #{feedId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="replyToCommentId != null "> and reply_to_comment_id = #{replyToCommentId}</if>
            <if test="replyToUserId != null "> and reply_to_user_id = #{replyToUserId}</if>
            <if test="likesCount != null "> and likes_count = #{likesCount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectWeightCommentById" parameterType="Long" resultMap="WeightCommentResult">
        <include refid="selectWeightCommentVo"/>
        where id = #{id}
    </select>

    <insert id="insertWeightComment" parameterType="WeightComment" useGeneratedKeys="true" keyProperty="id">
        insert into weight_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="feedId != null">feed_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="replyToCommentId != null">reply_to_comment_id,</if>
            <if test="replyToUserId != null">reply_to_user_id,</if>
            <if test="likesCount != null">likes_count,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="feedId != null">#{feedId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="replyToCommentId != null">#{replyToCommentId},</if>
            <if test="replyToUserId != null">#{replyToUserId},</if>
            <if test="likesCount != null">#{likesCount},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateWeightComment" parameterType="WeightComment">
        update weight_comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="feedId != null">feed_id = #{feedId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="replyToCommentId != null">reply_to_comment_id = #{replyToCommentId},</if>
            <if test="replyToUserId != null">reply_to_user_id = #{replyToUserId},</if>
            <if test="likesCount != null">likes_count = #{likesCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWeightCommentById" parameterType="Long">
        delete from weight_comment where id = #{id}
    </delete>

    <delete id="deleteWeightCommentByIds" parameterType="String">
        delete from weight_comment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>