<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.weight.mapper.WeightFeedbackMapper">

    <resultMap type="WeightFeedback" id="WeightFeedbackResult">
        <result property="id" column="id" />
        <result property="userId" column="user_id" />
        <result property="category" column="category" />
        <result property="content" column="content" />
        <result property="images" column="images" />
        <result property="contact" column="contact" />
        <result property="sourcePage" column="source_page" />
        <result property="environmentJson" column="environment_json" />
        <result property="status" column="status" />
        <result property="priority" column="priority" />
        <result property="replyContent" column="reply_content" />
        <result property="replyBy" column="reply_by" />
        <result property="replyTime" column="reply_time" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectWeightFeedbackVo">
        select id, user_id, category, content, images, contact, source_page, environment_json, status, priority, reply_content, reply_by, reply_time, create_by, create_time, update_by, update_time, remark from weight_feedback
    </sql>

    <select id="selectWeightFeedbackList" parameterType="WeightFeedback" resultMap="WeightFeedbackResult">
        <include refid="selectWeightFeedbackVo"/>
        <where>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="category != null and category != ''"> and category = #{category}</if>
            <if test="content != null and content != ''"> and content like concat('%', #{content}, '%')</if>
            <if test="contact != null and contact != ''"> and contact like concat('%', #{contact}, '%')</if>
            <if test="sourcePage != null and sourcePage != ''"> and source_page like concat('%', #{sourcePage}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="priority != null and priority != ''"> and priority = #{priority}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 --> and date_format(create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')</if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 --> and date_format(create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')</if>
        </where>
        order by create_time desc, id desc
    </select>

    <select id="selectWeightFeedbackById" parameterType="Long" resultMap="WeightFeedbackResult">
        <include refid="selectWeightFeedbackVo"/>
        where id = #{id}
    </select>

    <insert id="insertWeightFeedback" parameterType="WeightFeedback" useGeneratedKeys="true" keyProperty="id">
        insert into weight_feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="images != null">images,</if>
            <if test="contact != null">contact,</if>
            <if test="sourcePage != null">source_page,</if>
            <if test="environmentJson != null">environment_json,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="priority != null and priority != ''">priority,</if>
            <if test="replyContent != null">reply_content,</if>
            <if test="replyBy != null">reply_by,</if>
            <if test="replyTime != null">reply_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="images != null">#{images},</if>
            <if test="contact != null">#{contact},</if>
            <if test="sourcePage != null">#{sourcePage},</if>
            <if test="environmentJson != null">#{environmentJson},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="priority != null and priority != ''">#{priority},</if>
            <if test="replyContent != null">#{replyContent},</if>
            <if test="replyBy != null">#{replyBy},</if>
            <if test="replyTime != null">#{replyTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateWeightFeedback" parameterType="WeightFeedback">
        update weight_feedback
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="images != null">images = #{images},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="sourcePage != null">source_page = #{sourcePage},</if>
            <if test="environmentJson != null">environment_json = #{environmentJson},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="priority != null and priority != ''">priority = #{priority},</if>
            <if test="replyContent != null">reply_content = #{replyContent},</if>
            <if test="replyBy != null">reply_by = #{replyBy},</if>
            <if test="replyTime != null">reply_time = #{replyTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWeightFeedbackById" parameterType="Long">
        delete from weight_feedback where id = #{id}
    </delete>

    <delete id="deleteWeightFeedbackByIds" parameterType="String">
        delete from weight_feedback where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
